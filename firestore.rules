rules_version = '2';

// Vision Chain Firestore security rules.
//
// PROVENANCE: this file did not exist before P0. The live rules were managed
// only in the Firebase console and were exported with the Rules REST API
// (firebaserules.googleapis.com .../releases -> ruleset source) before being
// committed here, so this is the deployed ruleset plus the reward lock — NOT
// a fresh ruleset. That matters because `firebase deploy --only
// firestore:rules` replaces the live ruleset wholesale: publishing a
// hand-written file would have revoked access for every collection the app
// touches, not just the ones named below.
//
// WHAT CHANGED: the exported ruleset ended with
//
//     match /{document=**} { allow read, write: if request.auth != null; }
//
// i.e. ANY signed-in user could read and write ANY document in the project —
// including the RP ledger. That is why RP could be minted from devtools. A
// `allow write: if false` on a specific path cannot fix this: Firestore rules
// are additive, so a deny in one match never overrides an allow in another.
// The catch-all therefore had to become a match that can *exclude* paths,
// which is what `isRewardLedger()` below does.
//
// Reads are deliberately left as they were. Restricting them to "own document
// only" would break the referral and game leaderboards, which still scan these
// collections from the client. Read scoping lands with the server-side
// leaderboard aggregation; this phase closes the minting hole without
// regressing features.
service cloud.firestore {
  match /databases/{database}/documents {

    // Collections the catch-all at the bottom must not grant WRITE on, though
    // they are not reward ledgers: `users` and `referral_configs`, whose
    // dedicated rules below decide every write, and `admins`, which the
    // server once read as its admin list and which no client writes. Reads
    // are untouched: the catch-all's signed-in read is what all three
    // already allow.
    //
    // This is `hasDedicatedRule`'s job, done through `isRewardLedger` only
    // because those are the two predicates the catch-all consults, and the
    // pending patches in docs/pending/ (transactions, agents) both edit
    // `hasDedicatedRule` and the catch-all itself. Hooking in here keeps this
    // change applicable before or after either. Fold it into
    // `hasDedicatedRule` once they have landed.
    function isClosedToCatchAllWrites(col) {
      return col == 'users' || col == 'admins' || col == 'referral_configs';
    }

    // Collections that hold reward state. These are written exclusively by
    // Cloud Functions (the Admin SDK bypasses these rules), via:
    //   rp.award      -> user_reward_points, rp_history, user_streaks,
    //                    user_milestones, rp_daily_counters, rp_action_usage
    //   game.start    -> mini_game_plays, mini_game_tokens
    //   game.submit   -> mini_game_plays, user_reward_points, rp_history
    //   dailyRPDigest -> rp_daily_stats
    //   completeSignup             -> signup_records
    //   creditNodePurchaseReferral -> referral_purchase_claims,
    //                                 referral_rewards
    // A client write to any of them is a forgery attempt by definition.
    //
    // It also answers true for `isClosedToCatchAllWrites` — see there for why.
    function isRewardLedger(col) {
      return col in [
        'user_reward_points',
        'rp_history',
        'rp_daily_counters',
        'rp_daily_stats',
        'rp_action_usage',
        'user_streaks',
        'user_milestones',
        'mini_game_plays',
        'mini_game_tokens',
        'abuse_flags',
        'rp_risk_flags',
        'reward_policies',
        'reward_snapshots',
        'reward_snapshot_line_items',
        'payout_requests',
        'signup_records',
        'referral_purchase_claims',
        'referral_rewards',
        'revenue_monthly',
        'node_rollover_balances'
      ] || isClosedToCatchAllWrites(col);
    }

    // Admin is the `admin` custom claim: what every admin Cloud Function checks
    // (functions/adminGate.js), settable only with the Admin SDK
    // (functions/scripts/grant-admin-claims.cjs). The email list is the older
    // rules-only allowlist, kept so these rules do not depend on the claims
    // having been granted first; it can go once they have. `&&` binds tighter
    // than `||`: this is claim OR (signed in AND listed).
    function isAdmin() {
      return (request.auth != null && request.auth.token.get('admin', false) == true)
        || request.auth != null
        && request.auth.token.email in ['jays@visai.io', 'sangky94@gmail.com'];
    }

    // Transaction records (the explorer's index of on-chain activity).
    //
    // P0 SECURITY: this was `allow read, write: if true` — any ANONYMOUS
    // caller could create a document here. That was a mint. Two scheduled
    // relayers poll this very collection:
    //
    //   bridgeRelayer        type == "Bridge" && bridgeStatus in
    //                        {PENDING, LOCKED, FAILED} && challengeEndTime
    //                        <= now
    //   secureBridgeRelayer  type == "Bridge" && bridgeStatus in
    //                        {PENDING, SUBMITTED}
    //
    // and both took `value` and `recipient` straight from the document and
    // minted that amount to that address on the destination chain. Nothing
    // checked the source chain, so a forged document paid out. The gate in
    // functions/bridgeGate.js now verifies every payout against the lock on
    // chain; this rule stops the forged orders being written at all.
    //
    // Bridge records are SERVER records: functions/index.js writes
    // transactions/{lockTx.hash} in the same handler that performs the lock,
    // and the Admin SDK bypasses these rules, so the real flow is unaffected.
    // The client's own bridge write was keyed by the COMMIT tx hash — a
    // second work order for one lock — and it is gone from Wallet.tsx.
    //
    // Still allowed for a signed-in user: ordinary history records, the
    // reverse-bridge receipt (no relayer queries `ReverseBridge`), and
    // hiding a bridge from the Agent Desk, which touches two UI-only fields.
    // `get(key, default)` is used because most history records carry no
    // `type` at all, and reading a missing field would deny the write.
    function isRelayerActionable(data) {
      return data.get('type', '') == 'Bridge';
    }
    function changesOnlyDeskFlags() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['hiddenFromDesk', 'hiddenAt']);
    }
    match /transactions/{txId} {
      // Chain receipts. VisionScan reads these without a login, and every
      // field in them is already public on chain.
      allow read: if true;

      allow create: if request.auth != null
        && !isRelayerActionable(request.resource.data);

      // A bridge document may only have its desk flags toggled; anything
      // else about it — status, amount, recipient — is the server's.
      allow update: if request.auth != null
        && (changesOnlyDeskFlags()
            || (!isRelayerActionable(resource.data)
                && !isRelayerActionable(request.resource.data)));

      // Nothing in the app deletes a receipt; `if true` let anyone erase the
      // whole history.
      allow delete: if false;
    }

    // Users collection.
    //
    // P0 SECURITY: admin used to be `role == 'admin'` on the caller's own
    // document — read by every admin Cloud Function and by the admin console's
    // login. The owner-only write here restricted no fields, and it was not
    // binding anyway, because the catch-all at the bottom also matched this
    // path and rules are additive. So any signed-in user could make themselves
    // an admin (adminFundPool spends the executor wallet), or rewrite anyone
    // else's document. Admin is now the custom claim (isAdmin above), and the
    // catch-all no longer grants write here (isClosedToCatchAllWrites).
    //
    // Who may write a users document now:
    //   - its owner: anything, except that a privilege key (role, isAdmin,
    //     permissions) may only stay as stored or drop to its default. Signup
    //     creates the document with role 'user'; account activation merges
    //     role 'user' back in.
    //   - an admin: anything (the console sets role 'partner', bumps
    //     adminSentTotal, pre-registers invitees).
    //   - a partner: an invitation stub for an address with no document yet
    //     (manualInviteUser). `role` is trustworthy to read here now that
    //     only an admin can set it.
    //   - nobody else. The bookkeeping signup and referrals do on SOMEONE
    //     ELSE's document — the referrer's referralCount, the duplicate-phone
    //     block on accounts sharing a number, the referrers' reward totals —
    //     is done by Cloud Functions (completeSignup and
    //     creditNodePurchaseReferral in functions/referralLedger.js), which
    //     re-derive each value instead of taking it from the caller. Any
    //     signed-in user used to be allowed those writes here, which let
    //     anyone add to anyone's referralCount or reward totals, or set anyone's
    //     phoneDuplicateBlocked (a transfer block). getUserData now fills in a
    //     missing referralCode only on the caller's own document.
    function isOwner(email) {
      return request.auth != null && request.auth.token.email == email;
    }

    // A new document may carry only the default privileges.
    function isUnprivileged(data) {
      return data.get('role', 'user') == 'user'
        && data.get('isAdmin', false) == false
        && data.get('permissions', null) == null;
    }

    // `get(key, default)` because most documents carry none of these keys,
    // and reading a missing field would deny the write.
    function keepsOrLowers(key, lowest) {
      return request.resource.data.get(key, lowest) == lowest
        || request.resource.data.get(key, lowest) == resource.data.get(key, lowest);
    }
    function keepsPrivilege() {
      return keepsOrLowers('role', 'user')
        && keepsOrLowers('isAdmin', false)
        && keepsOrLowers('permissions', null);
    }

    function isPartner() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.get('role', 'user') == 'partner';
    }
    function isInvitationStub(data) {
      return data.keys().hasOnly(['email', 'role', 'partnerCode', 'status', 'createdAt'])
        && data.get('role', 'user') == 'user'
        && data.get('status', '') == 'PendingActivation';
    }

    match /users/{email} {
      allow read: if request.auth != null;
      allow create: if (isOwner(email) && isUnprivileged(request.resource.data))
        || (isPartner() && isInvitationStub(request.resource.data));
      allow update: if isOwner(email) && keepsPrivilege();
      allow delete: if isOwner(email);
      allow write: if isAdmin();
    }

    // Per-user subcollections (notifications, contacts, …). Still open to any
    // signed-in user: signup writes the referrer's contacts, and several
    // features write other users' notifications.
    //
    // This used to be `match /users/{email}/{sub=**}`. In rules version 2 a
    // `=**` wildcard matches ZERO or more segments, so that pattern also
    // matched users/{email} itself and granted any signed-in user write on
    // every users document, whatever the rule above said. Naming the
    // subcollection segment makes it match subcollection documents only.
    match /users/{email}/{subcollection}/{rest=**} {
      allow read, write: if request.auth != null;
    }

    // Referral reward rates and the events that earn them. The server takes
    // the rates from here when it credits a node purchase
    // (creditNodePurchaseReferral), so a client that could write this could
    // still set its referrer's reward. Read by the app (getReferralConfig),
    // written only by the admin console (AdminReferrals).
    match /referral_configs/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // RP rates drive every award the server makes, so a client that can write
    // this document can still inflate its own rewards indirectly. Readable by
    // the app (getRPConfig), writable only by an admin. The admin RP console
    // writes config/rp_rewards directly and keeps working.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Agent accounts: one document per registered AI agent, keyed by name.
    //
    // P0 SECURITY: there was no rule here, so the catch-all below let ANY
    // signed-in user read and write every agent. Each document holds the
    // agent's plaintext `apiKey`, which authorises Agent Gateway calls that
    // move that agent's VCN, and its server-encrypted `privateKey`. It also
    // holds what the gateway now enforces on that key — the declared scope
    // (`hosting.allowed_actions`), the identity (`sbtStatus`,
    // `walletAddress`) and `status` — so a client that could write here could
    // undo every one of those checks for any agent.
    //
    // Every writer is a Cloud Function (agentGateway, agentExecutor and the
    // hosted loop) on the Admin SDK, which bypasses these rules. That includes
    // all the subcollections: transactions, authority_delegations,
    // authority_audit, kv_store, pipelines, webhooks, webhook_logs,
    // hosting_logs, node. The only clients are in the admin console: the
    // agent table (getAllAgents, and its delete button) and the dashboard's
    // agent count. Note that `isAdmin()` is the email list, not the `role`
    // field the console's own login checks.
    match /agents/{agentId} {
      allow read, write: if isAdmin();
    }
    match /agents/{agentId}/{sub=**} {
      allow read, write: if isAdmin();
    }

    // API fees the gateway failed to collect or could not confirm
    // (recordFeeReconciliation in functions/index.js). A server ledger of who
    // owes what: an admin may read it, and no client may write it — one that
    // could would erase its own debts or invent someone else's.
    match /fee_reconciliation/{docId} {
      allow read: if isAdmin();
    }

    // Server-owned collections, closed to the catch-all below. Same meaning
    // as `hasDedicatedRule`; it is a separate predicate only so this change
    // and the `transactions` one could each land without the other.
    function isServerOwned(col) {
      return col == 'agents' || col == 'fee_reconciliation';
    }

    // Web push device tokens. Written by the browser when a user enables
    // push, read only by Cloud Functions when sending. A token is a delivery
    // address, not a secret, but it does identify a device — so a client may
    // only touch a document it owns, and may not enumerate anyone else's.
    // Read/delete check the STORED owner, create/update the INCOMING one —
    // combining them into a single `write` rule reads `request.resource` on
    // delete, where it is null, and silently denies.
    match /fcm_tokens/{token} {
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.token.email;
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.token.email;
    }

    // Everything else: previous behaviour (any signed-in user), EXCEPT the
    // reward ledgers (server-write-only), `config` (admin-write-only) and
    // `transactions` (no bridge records from a client).
    //
    // `config` MUST be excluded here explicitly. Firestore rules are additive,
    // so the admin-only `allow write` above grants nothing on its own — this
    // catch-all would re-open it. Verified by the rules test suite: without
    // the exclusion, "non-admin writes config/rp_rewards" passes when it
    // should be denied.
    function hasDedicatedRule(col) {
      return col == 'config' || col == 'fcm_tokens' || col == 'transactions';
    }

    // `hasDedicatedRule` must gate READ as well as write. Rules are additive,
    // so an unconditional `allow read` here re-grants read on any collection
    // that defines a narrower read rule above — which is how a user could
    // still fetch someone else's push token despite the owner check.
    match /{col}/{docId} {
      allow read: if request.auth != null
        && !hasDedicatedRule(col)
        && !isServerOwned(col);
      allow write: if request.auth != null
        && !isRewardLedger(col)
        && !hasDedicatedRule(col)
        && !isServerOwned(col);
    }

    match /{col}/{docId}/{sub=**} {
      allow read: if request.auth != null
        && !hasDedicatedRule(col)
        && !isServerOwned(col);
      allow write: if request.auth != null
        && !isRewardLedger(col)
        && !hasDedicatedRule(col)
        && !isServerOwned(col);
    }
  }
}
